
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String
  email        String    @unique
  passwordHash String
  role         String    @default("CLIENT")
  createdAt    DateTime  @default(now())
  bookings     Booking[]
  reviews      Review[]
}

model Destination {
  id          Int       @id @default(autoincrement())
  name        String
  country     String
  description String?
  imageUrl    String?
  packages    Package[]
  reviews     Review[]
}

model Package {
  id             Int         @id @default(autoincrement())
  title          String
  description    String?
  durationDays   Int?
  price          Decimal     @db.Decimal(10, 2)
  startDate      DateTime
  endDate        DateTime
  availableSeats Int
  destinationId  Int
  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  reviews        Review[]
  hotels         Hotel[]
  flights        Flight[]
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

}

model Booking {
  id             Int      @id @default(autoincrement())
  userId         Int
  packageId      Int
  bookingDate    DateTime @default(now())
  status         String   @default("PENDING")
  totalPrice     Decimal  @db.Decimal(10, 2)
  numberOfPeople Int      @default(1)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  package        Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payments       Payment[]
}


model Review {
  id            Int          @id @default(autoincrement())
  userId        Int
  destinationId Int?
  packageId     Int?
  rating        Int
  comment       String?      @db.NVarChar(2000)
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  package       Package?     @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}



model Payment {
  id        Int      @id @default(autoincrement())
  bookingId Int
  amount    Decimal  @db.Decimal(10, 2)
  method    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Hotel {
  id             Int     @id @default(autoincrement())
  name           String
  city           String
  address        String?
  nightlyPrice   Decimal @db.Decimal(10, 2)
  availableRooms Int     @default(0)
  packageId      Int

  package        Package @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Flight {
  id               Int      @id @default(autoincrement())
  airline          String
  flightNumber     String
  departureAirport String
  arrivalAirport   String
  departureTime    DateTime
  arrivalTime      DateTime
  packageId        Int

  package          Package  @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}


model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  packages    Package[]
}
